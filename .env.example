# 默认离线规则模式：不需要 API，也不会上传文档内容。
DOC_RENAMER_PROVIDER=rules
DOC_RENAMER_API_BASE=
DOC_RENAMER_API_KEY=
DOC_RENAMER_MODEL=
DOC_RENAMER_TIMEOUT=90
DOC_RENAMER_RETRIES=3

# DeepSeek 示例（使用时请替换上面的同名配置，不要保留两组生效值；
# deepseek-chat/deepseek-reasoner 已于 2026-07-24 停用）：
# DOC_RENAMER_PROVIDER=chat
# DOC_RENAMER_API_BASE=https://api.deepseek.com
# DOC_RENAMER_API_KEY=你的真实API密钥
# DOC_RENAMER_MODEL=deepseek-v4-flash
# 更强模型可按账户权限改为 deepseek-v4-pro
# DOC_RENAMER_TIMEOUT=90
# DOC_RENAMER_RETRIES=3
